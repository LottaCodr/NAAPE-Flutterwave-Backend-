# Runtime
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/naape
JWT_SECRET=replace-with-a-long-random-secret

# Browser clients (comma-separated additions to built-in NAAPE origins)
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:3000

# Flutterwave
FLW_BASE_URL=https://api.flutterwave.com/v3
FLW_SECRET_KEY=FLWSECK_TEST-...
FLW_HASH=replace-with-your-webhook-secret
FLW_REDIRECT_URL=http://localhost:3000/payment/complete

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SendGrid email
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@naape.ng
MEMBERSHIP_ADMIN_EMAIL=info@naape.org.ng

# Optional AI title suggestions
OPENAI_API_KEY=
